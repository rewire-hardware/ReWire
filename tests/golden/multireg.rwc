device top_level
      input __in0 : [4]
      output __out0 : [16]
      register __st0 : [4] init 4'h0
      register __st1 : [8] init 8'h3
      register __st2 : [16] init 16'h5
      tag $x2 = 0
      let $res = let s11$i4 = add (zext 8 __st0) __st1 in
            let s21$i5 = add (zext 16 __st1) __st2 in
            add (zext 16 __st0) __st2 # __in0 # s11$i4 # s21$i5
      __out0 := $res[28 +: 16]
      next __st0 := $res[24 +: 4]
      next __st1 := $res[16 +: 8]
      next __st2 := $res[0 +: 16]