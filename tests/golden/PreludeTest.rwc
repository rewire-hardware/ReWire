Main.zookus : ([1]) -> [1]
Main.zookus x =
      x

device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __resumption_tag : [2] init 2'h2
      tag b2 = 0
      tag b = 1
      let $res = if not __resumption_tag[1 +: 1] then (let a$i0 = __resumption_tag[0 +: 1] in
                  let $a$i1 = Main.zookus a$i0 in
                  let $a1$i2 = Main.zookus $a$i1 in
                  $a1$i2 # 1'h0 # a$i0)
                  else 3'h0
      __out0 := $res[2 +: 1]
      next __resumption_tag := $res[0 +: 2]