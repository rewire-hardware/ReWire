--| block '$L.Main.sig' of process main
main.sig : ([8], [8]) -> [24]
main.sig s0 s1 =
      s0 # s0 # s1

device top_level
      input __in0 : [1]
      output __out0 : [8]
      register __st0 : [8] init 8'h0
      register __st1 : [8] init 8'h1
      tag i = 0
      let $res = if not __in0 then main.sig __st0 __st1
                  else let s11$i3 = add __st0 __st1 in
                  main.sig __st1 s11$i3
      __out0 := $res[16 +: 8]
      next __st0 := $res[8 +: 8]
      next __st1 := $res[0 +: 8]