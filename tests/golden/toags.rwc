--| block '$L.y' of process main (state 1)
main.y : ([1], [1], [1], [1]) -> [6]
main.y x y s0 s1 =
      let $a = (if not y then (let $a = (if x then x
                  else 1'h0) in
            $a)
            else x) in
      let $a1 = (if $a then y
            else 1'h0) in
      $a1 # 2'h0 # y # s0 # s1

device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __resumption_tag : [3] init 3'h4
      register __st0 : [1] init 1'h0
      register __st1 : [1] init 1'h1
      tag z = 0
      tag y = 1
      tag x = 2
      let $res = if eq __resumption_tag[1 +: 2] 2'h0 then (let y$i1 = __resumption_tag[0 +: 1] in
                  4'h4 # __st0 # y$i1)
                  else if eq __resumption_tag[1 +: 2] 2'h1 then main.y __resumption_tag[0 +: 1] __in0 __st0 __st1 else if not __in0 then main.y __in0 __st0 __st0 __st1 else 3'h1 # __in0 # __st0 # __st1
      __out0 := $res[5 +: 1]
      next __resumption_tag := $res[2 +: 3]
      next __st0 := $res[1 +: 1]
      next __st1 := $res[0 +: 1]