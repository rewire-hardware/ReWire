// Generated by rwc from device: top_level.
// rw_device maps a sequence of per-cycle inputs to per-cycle outputs.

module top_level where

// Helpers implementing ReWire Hyle primitive semantics.
rw'resize : {m, n} (fin m, fin n) => [n] -> [m]
rw'resize x = drop`{n} ((zero : [m]) # x)

rw'repl : {n, w} (fin n, fin w) => [w] -> [n * w]
rw'repl x = join (repeat`{n} x)

rw'parity : {n} (fin n) => [n] -> Bit
rw'parity x = foldr (^) False x

rw'sext : {m, n} (fin m, fin n, n >= 1) => [n] -> [m]
rw'sext x = if x @ 0 then ~ (rw'resize (~ x)) else rw'resize x

// Per-cycle step: outputs # next register values.
rw_step : [30] -> [10] -> [46]
rw_step st i = (take`{16} s26) # (drop`{16} s26)
  where
    s0 : [30]
    s0 = st
    s1 : [10]
    s1 = i
    s2 : [4]
    s2 = drop`{6} s1
    s3 : [1]
    s3 = take`{1} s0
    s4 : [8]
    s4 = drop`{2} s1
    s5 : [1]
    s5 = take`{1} s0
    s6 : [5]
    s6 = take`{5} (drop`{1} s0)
    s7 : [1]
    s7 = drop`{9} s1
    s8 : [9]
    s8 = take`{9} (drop`{6} s0)
    s9 : [9]
    s9 = take`{9} (drop`{6} s0)
    s10 : [4]
    s10 = take`{4} (drop`{2} s0)
    s11 : [45]
    s11 = (if (take`{2} s1) == 0b00 then (s3 # (0b1 # (s2 # (0b00000 # s2)))) else (if (take`{2} s1) == 0b01 then (s5 # (s6 # (0b1 # s4))) else (if ~ (s7 @ 0) then (0b000000 # s8) else (if ~ ((take`{1} (drop`{1} s0)) @ 0) then (0b100000 # s9) else (0b10000000000 # s10))))) # s0
    s12 : [15]
    s12 = take`{15} s11
    s13 : [30]
    s13 = drop`{15} s11
    s14 : [45]
    s14 = s12 # ((take`{15} (drop`{15} s11)) # (rw'resize`{15} (s13 >> 0x00000000000000000000000000000000)))
    s15 : [15]
    s15 = drop`{30} s14
    s16 : [15]
    s16 = s15
    s17 : [1]
    s17 = take`{1} s16
    s18 : [5]
    s18 = take`{5} (drop`{1} s16)
    s19 : [9]
    s19 = drop`{6} s16
    s20 : [4]
    s20 = drop`{11} s16
    s21 : [8]
    s21 = drop`{7} s16
    s22 : [30]
    s22 = take`{30} s14
    s23 : [46]
    s23 = (if ~ (s17 @ 0) then (0b0000000 # s19) else (if ~ ((take`{1} (drop`{6} s16)) @ 0) then (0b11 # (s18 # (0b00000 # s20))) else (0b01 # (s18 # (0b1 # s21))))) # s22
    s24 : [16]
    s24 = take`{16} s23
    s25 : [30]
    s25 = drop`{16} s23
    s26 : [46]
    s26 = s24 # s25

// Device: top_level
// Inputs, MSB-first: __in0 : [10]
// Outputs, MSB-first: __out0 : [16]
rw_device : {n} (fin n) => [n][10] -> [n][16]
rw_device ins = outs
  where
    rs : [n][46]
    rs = [rw_step st i | st <- sts | i <- ins]
    sts : [1 + n][30]
    sts = [0b000000000000000000000000000000] # [drop`{16} r | r <- rs]
    outs : [n][16]
    outs = [take`{16} r | r <- rs]