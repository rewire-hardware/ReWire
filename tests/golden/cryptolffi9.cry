    s20 : [8]
    s20 = (s19 << 0b1) ^ (if (take`{1} s19) @ 0 then 0x1d else 0x00)
    s21 : [32]
    s21 = rw'resize`{32} s0
    s22 : [8]
    s22 = (((((rw'resize`{8} (s0 # ((s0 + 0x01) # ((s0 + 0x02) # ((s0 + 0x03) # (s0 + 0x04)))))) + s5) + (rw'resize`{8} ((s1 + (0x02 * ((s1 + 0x02) - s1))) # ((s1 + (0x03 * ((s1 + 0x02) - s1))) # (s1 + (0x04 * ((s1 + 0x02) - s1))))))) + (rw'resize`{8} (s1 # (s6 # (s8 # (s11 # (s15 # s20))))))) + (rw'resize`{8} (((take`{8} s21) + 0x00) # (((take`{8} (drop`{8} s21)) + 0x01) # (((take`{8} (drop`{16} s21)) + 0x02) # ((drop`{24} s21) + 0x03)))))) + (rw'resize`{8} (s1 # (s1 # (s1 # s1))))
