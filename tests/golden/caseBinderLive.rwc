--| block '$L.$ds' of process main
main.$ds : ([1]) -> [3]
main.$ds s0 =
      s0 # 1'h0 # s0

device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __resumption_tag : [1] init 1'h1
      register __st0 : [1] init 1'h0
      tag $ds2 = 0
      tag i = 1
      let $res = if not __resumption_tag then 2'h3 # __st0
                  else if not __in0 then (let $a$i3 = not __st0 in
                  main.$ds $a$i3) else main.$ds __in0
      __out0 := $res[2 +: 1]
      next __resumption_tag := $res[1 +: 1]
      next __st0 := $res[0 +: 1]