--| block '$L._unused' of process main
main._unused : ([1], [1]) -> [3]
main._unused s0 s1 =
      s0 # s0 # s1

device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __st0 : [1] init 1'h1
      register __st1 : [1] init 1'h1
      tag $x2 = 0
      let $res = let $a$i3 = not __in0 in
            if not $a$i3 then main._unused __st0 __st1
                  else let s11$i5 = (let $t1$i4 = xor __st0 __st1 in
                  $t1$i4) in
                  main._unused __st1 s11$i5
      __out0 := $res[2 +: 1]
      next __st0 := $res[1 +: 1]
      next __st1 := $res[0 +: 1]