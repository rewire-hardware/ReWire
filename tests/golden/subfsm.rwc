device top_level
      input __in0 : [1]
      output __out0 : [8]
      register __resumption_tag : [9] init 9'h100
      register __st0 : [8] init 8'h0
      tag $ds = 0
      tag i = 1
      let $res = if not __resumption_tag[8 +: 1] then 25'h10000
                  else let s$i2 = __resumption_tag[0 +: 8] in
                  let s01$i4 = add s$i2 8'h1 in
                  if not __in0 then add s$i2 s$i2 # 9'h0 # s01$i4
                        else s01$i4 # 1'h1 # s01$i4 # s01$i4
      __out0 := $res[17 +: 8]
      next __resumption_tag := $res[8 +: 9]
      next __st0 := $res[0 +: 8]