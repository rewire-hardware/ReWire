device top_level
      input __in0 : [8]
      output __out0 : [8]
      register __resumption_tag : [8] init 8'h3
      register __st0 : [8] init 8'h0
      tag i = 0
      let $res = add __in0 __resumption_tag # __resumption_tag # __in0
      __out0 := $res[16 +: 8]
      next __resumption_tag := $res[8 +: 8]
      next __st0 := $res[0 +: 8]