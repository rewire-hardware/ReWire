--| block '$L.Main.dev' of process main
main.dev : ([8], [8]) -> [25]
main.dev k s0 =
      add s0 k # 1'h0 # k # s0

device top_level
      input __in0 : [8]
      output __out0 : [8]
      register __resumption_tag : [9] init 9'h100
      register __st0 : [8] init 8'h0
      tag i2 = 0
      tag i = 1
      let $res = if not __resumption_tag[8 +: 1] then (let k$i1 = __resumption_tag[0 +: 8] in
                  main.dev k$i1 __in0)
                  else main.dev __in0 8'h0
      __out0 := $res[17 +: 8]
      next __resumption_tag := $res[8 +: 9]
      next __st0 := $res[0 +: 8]