// Inputs, MSB-first: __in0 : [46]
// Outputs, MSB-first: __out0 : [33]
rw_device : {n} (fin n) => [n][46] -> [n][33]
rw_device ins = outs
  where
    rs : [n][241]
    rs = [rw_step st i | st <- sts | i <- ins]
    sts : [1 + n][208]
    sts = [0x8006000000000000000000000000000000000000000000000000] # [drop`{33} r | r <- rs]
    outs : [n][33]
    outs = [take`{33} r | r <- rs]