--| block '$L._unused' of process main
main._unused : ([1]) -> [2]
main._unused s0 =
      1'h0 # s0

device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __st0 : [1] init 1'h1
      tag x = 0
      let $res = if not __st0 then main._unused __st0
                  else main._unused __st0
      __out0 := $res[1 +: 1]
      next __st0 := $res[0 +: 1]