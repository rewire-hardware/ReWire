Main.x2 : ([100]) -> [100]
Main.x2 x =
      mul x 100'h2

device top_level
      input __in0 : [100]
      output __out0 : [100]
      register __resumption_tag : [1000] init 1000'h0
      register __st0 : [1000] init 1000'h0
      tag i = 0
      let $res = let $a$i3 = Main.x2 __resumption_tag[800 +: 100] # Main.x2 __resumption_tag[700 +: 100] # Main.x2 __resumption_tag[600 +: 100] # Main.x2 __resumption_tag[500 +: 100] # Main.x2 __resumption_tag[400 +: 100] # Main.x2 __resumption_tag[300 +: 100] # Main.x2 __resumption_tag[200 +: 100] # Main.x2 __resumption_tag[100 +: 100] # Main.x2 __resumption_tag[0 +: 100] # Main.x2 __in0 in
            $a$i3[900 +: 100] # $a$i3 # $a$i3
      __out0 := $res[2000 +: 100]
      next __resumption_tag := $res[1000 +: 1000]
      next __st0 := $res[0 +: 1000]