    s8 = (rw_Main_swapix4 s7 0b00000) # ((rw_Main_swapix4 s7 0b00001) # ((rw_Main_swapix4 s7 0b00010) # ((rw_Main_swapix4 s7 0b00011) # ((rw_Main_swapix4 s7 0b00100) # ((rw_Main_swapix4 s7 0b00101) # ((rw_Main_swapix4 s7 0b00110) # ((rw_Main_swapix4 s7 0b00111) # ((rw_Main_swapix4 s7 0b01000) # ((rw_Main_swapix4 s7 0b01001) # ((rw_Main_swapix4 s7 0b01010) # ((rw_Main_swapix4 s7 0b01011) # ((rw_Main_swapix4 s7 0b01100) # ((rw_Main_swapix4 s7 0b01101) # ((rw_Main_swapix4 s7 0b01110) # ((rw_Main_swapix4 s7 0b01111) # ((rw_Main_swapix4 s7 0b10000) # ((rw_Main_swapix4 s7 0b10001) # ((rw_Main_swapix4 s7 0b10010) # ((rw_Main_swapix4 s7 0b10011) # ((rw_Main_swapix4 s7 0b10100) # ((rw_Main_swapix4 s7 0b10101) # ((rw_Main_swapix4 s7 0b10110) # ((rw_Main_swapix4 s7 0b10111) # ((rw_Main_swapix4 s7 0b11000) # ((rw_Main_swapix4 s7 0b11001) # ((rw_Main_swapix4 s7 0b11010) # ((rw_Main_swapix4 s7 0b11011) # ((rw_Main_swapix4 s7 0b11100) # ((rw_Main_swapix4 s7 0b11101) # ((rw_Main_swapix4 s7 0b11110) # (rw_Main_swapix4 s7 0b11111)))))))))))))))))))))))))))))))
