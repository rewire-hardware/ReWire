                        else if eq __st1 7'h1 then main.getReg __in1 disc$i0 else if eq __st1 7'h2 then main.putReg __in1 disc$i0 else if eq __st1 7'h3 then main.getReg __in1 disc$i0 else if eq __st1 7'h4 then (let $a$i5 = test2 __in1 __st0 in
