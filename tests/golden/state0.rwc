device top_level
      input __in0 : [3]
      output __out0 : [1]
      output __out1 : [3]
      register __resumption_tag : [6] init 6'h20
      tag $x2 = 0
      tag _unused = 1
      tag _unused2 = 2
      tag _unused3 = 3
      tag _unused4 = 4
      let $res = if eq __resumption_tag[3 +: 3] 3'h0 then 7'h2 # __in0
                  else if eq __resumption_tag[3 +: 3] 3'h1 then (let i$i0 = __resumption_tag[0 +: 3] in
                  let $a$i1 = 1'h1 # i$i0 in
                  $a$i1 # 6'h0) else if eq __resumption_tag[3 +: 3] 3'h2 then (let i$i2 = __resumption_tag[0 +: 3] in
                  7'h1 # i$i2) else if eq __resumption_tag[3 +: 3] 3'h3 then 10'h200 else 10'h18
      __out0 := $res[9 +: 1]
      __out1 := $res[6 +: 3]
      next __resumption_tag := $res[0 +: 6]