--| block '$L._unused2' of process main
main._unused2 : ([1], [1]) -> [2]
main._unused2 s s0 =
      s # s0

--| block '$L._unused' of process main
main._unused : ([1], [1]) -> [2]
main._unused s s0 =
      if not s then main._unused2 s 1'h1
            else main._unused2 s s0

device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __st0 : [1] init 1'h1
      tag b = 0
      let $res = if not __in0 then (if not __st0 then main._unused __st0 __st0
                        else main._unused __st0 1'h0)
                  else 2'h2
      __out0 := $res[1 +: 1]
      next __st0 := $res[0 +: 1]