device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __st0 : [1] init 1'h0
      tag $x2 = 0
      let $res = let $a$i1 = (let $t1$i0 = xor __st0 __in0 in
            $t1$i0) # __st0 in
            let o$i2 = $a$i1[1 +: 1] in
            let s$i3 = $a$i1[0 +: 1] in
            o$i2 # s$i3
      __out0 := $res[1 +: 1]
      next __st0 := $res[0 +: 1]