// Generated by rwc from device: top_level.
// rw_device maps a sequence of per-cycle inputs to per-cycle outputs.

module top_level where

// Helpers implementing ReWire Hyle primitive semantics.
rw'resize : {m, n} (fin m, fin n) => [n] -> [m]
rw'resize x = drop`{n} ((zero : [m]) # x)

rw'repl : {n, w} (fin n, fin w) => [w] -> [n * w]
rw'repl x = join (repeat`{n} x)

rw'parity : {n} (fin n) => [n] -> Bit
rw'parity x = foldr (^) False x

rw'sext : {m, n} (fin m, fin n, n >= 1) => [n] -> [m]
rw'sext x = if x @ 0 then ~ (rw'resize (~ x)) else rw'resize x

// Main.andModel
rw_Main_andModel : [32] -> [32] -> [32]
rw_Main_andModel x0 x1 = x0 && x1

// Main.xorModel
rw_Main_xorModel : [32] -> [32] -> [32]
rw_Main_xorModel x0 x1 = x0 ^ x1

// Main.notModel
rw_Main_notModel : [32] -> [32]
rw_Main_notModel x0 = ~ x0

// Main.plusModel
rw_Main_plusModel : [32] -> [32] -> [32]
rw_Main_plusModel x0 x1 = x0 + x1

// Per-cycle step: outputs # next register values.
rw_step : [32] -> [32]
rw_step i = s5
  where
    s0 : [32]
    s0 = i
    s1 : [32]
    s1 = rw_Main_andModel s0 0xf0f0f0f0
    s2 : [32]
    s2 = rw_Main_notModel s0
    s3 : [32]
    s3 = rw_Main_xorModel s2 0x12345678
    s4 : [32]
    s4 = rw_Main_plusModel s1 s3
    s5 : [32]
    s5 = s4

// Device: top_level
// Inputs, MSB-first: __in0 : [32]
// Outputs, MSB-first: __out0 : [32]
rw_device : {n} (fin n) => [n][32] -> [n][32]
rw_device ins = [rw_step i | i <- ins]