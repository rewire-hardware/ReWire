--| block '$L.Main.first2' of process main
main.first2 : ([16]) -> [24]
main.first2 s0 =
      let r0$i0 = s0[8 +: 8] in
      r0$i0 # s0

device top_level
      input __in0 : [1]
      output __out0 : [8]
      register __st0 : [16] init 16'h1
      tag i = 0
      let $res = if not __in0 then (let r0$i0 = __st0[8 +: 8] in
                  let r1$i1 = trunc 8 (lshr __st0 128'h0) in
                  let $a$i2 = add r0$i0 r1$i1 in
                  let s01$i3 = r1$i1 # $a$i2 in
                  main.first2 s01$i3)
                  else main.first2 __st0
      __out0 := $res[16 +: 8]
      next __st0 := $res[0 +: 16]