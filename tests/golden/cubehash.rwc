--| block '$L.arm2' of process main
--| also: main._unused
main.arm2 : ([1024]) -> [2048]
main.arm2 s0 =
      s0 # s0

Main.explode5 : ([5]) -> [5]
Main.explode5 w5 =
      trunc 1 (lshr w5 128'h4) # trunc 1 (lshr w5 128'h3) # trunc 1 (lshr w5 128'h2) # trunc 1 (lshr w5 128'h1) # trunc 1 (lshr w5 128'h0)

Main.rot : ([32], [1024], [5]) -> [32]
Main.rot rc s f32 =
      let $ds = (let $t0$i0 = Main.explode5 f32 in
      let h$i1 = $t0$i0[4 +: 1] in
      h$i1) # trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 f32)) 128'h1) 128'h20)) in
      let w0 = (let w0 = $ds[0 +: 32] in
      w0) in
      let $t0 = (let h = $ds[32 +: 1] in
      h) in
      if not $t0 then or (shl w0 rc) (lshr w0 (sub 32'h20 rc))
            else w0

Main.addix : ([1024], [5]) -> [32]
Main.addix s f32 =
      let $ds = (let $ds$i0 = Main.explode5 f32 in
      let j$i2 = (let j$i1 = $ds$i0[3 +: 1] in
      j$i1) in
      let k$i4 = (let k$i3 = $ds$i0[2 +: 1] in
      k$i3) in
      let l$i6 = (let l$i5 = $ds$i0[1 +: 1] in
      l$i5) in
      let m$i8 = (let m$i7 = $ds$i0[0 +: 1] in
      m$i7) in
      (let h$i9 = $ds$i0[4 +: 1] in
      h$i9) # trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (1'h0 # j$i2 # k$i4 # l$i6 # m$i8))) 128'h1) 128'h20)) # trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (1'h1 # j$i2 # k$i4 # l$i6 # m$i8))) 128'h1) 128'h20))) in
      let v0 = (let v0 = $ds[32 +: 32] in
      v0) in
      let $t0 = (let h = $ds[64 +: 1] in
      h) in
      if not $t0 then v0
            else add v0 (let v1 = $ds[0 +: 32] in
            v1)

Main.add : ([1024]) -> [1024]
Main.add s =
      Main.addix s 5'h0 # Main.addix s 5'h1 # Main.addix s 5'h2 # Main.addix s 5'h3 # Main.addix s 5'h4 # Main.addix s 5'h5 # Main.addix s 5'h6 # Main.addix s 5'h7 # Main.addix s 5'h8 # Main.addix s 5'h9 # Main.addix s 5'ha # Main.addix s 5'hb # Main.addix s 5'hc # Main.addix s 5'hd # Main.addix s 5'he # Main.addix s 5'hf # Main.addix s 5'h10 # Main.addix s 5'h11 # Main.addix s 5'h12 # Main.addix s 5'h13 # Main.addix s 5'h14 # Main.addix s 5'h15 # Main.addix s 5'h16 # Main.addix s 5'h17 # Main.addix s 5'h18 # Main.addix s 5'h19 # Main.addix s 5'h1a # Main.addix s 5'h1b # Main.addix s 5'h1c # Main.addix s 5'h1d # Main.addix s 5'h1e # Main.addix s 5'h1f

Main.swapix1 : ([1024], [5]) -> [32]
Main.swapix1 s f32 =
      let $ds = Main.explode5 f32 in
      let b1 = (let b1 = $ds[4 +: 1] in
      b1) in
      let b2 = (let b2 = $ds[3 +: 1] in
      b2) in
      let k = (let k = $ds[2 +: 1] in
      k) in
      let l = (let l = $ds[1 +: 1] in
      l) in
      let m = (let m = $ds[0 +: 1] in
      m) in
      let $t1 = (let $t0 = not b1 in
      if $t0 then b2
            else 1'h0) in
      if not $t1 then (let $t3 = (let $t2 = not b1 in
            if $t2 then not b2
                  else 1'h0) in
            if not $t3 then trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 f32)) 128'h1) 128'h20))
                  else trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (2'h1 # k # l # m))) 128'h1) 128'h20)))
            else trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (2'h0 # k # l # m))) 128'h1) 128'h20))

Main.swapix2 : ([1024], [5]) -> [32]
Main.swapix2 s f32 =
      let $ds = Main.explode5 f32 in
      let b1 = (let b1 = $ds[4 +: 1] in
      b1) in
      let j = (let j = $ds[3 +: 1] in
      j) in
      let k = (let k = $ds[2 +: 1] in
      k) in
      let b2 = (let b2 = $ds[1 +: 1] in
      b2) in
      let m = (let m = $ds[0 +: 1] in
      m) in
      let $t0 = (if b1 then not b2
            else 1'h0) in
      if not $t0 then (let $t1 = (if b1 then b2
                  else 1'h0) in
            if not $t1 then trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 f32)) 128'h1) 128'h20))
                  else trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (1'h1 # j # k # 1'h0 # m))) 128'h1) 128'h20)))
            else trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (1'h1 # j # k # 1'h1 # m))) 128'h1) 128'h20))

Main.swapix3 : ([1024], [5]) -> [32]
Main.swapix3 s f32 =
      let $ds = Main.explode5 f32 in
      let b1 = (let b1 = $ds[4 +: 1] in
      b1) in
      let j = (let j = $ds[3 +: 1] in
      j) in
      let b2 = (let b2 = $ds[2 +: 1] in
      b2) in
      let l = (let l = $ds[1 +: 1] in
      l) in
      let m = (let m = $ds[0 +: 1] in
      m) in
      let $t1 = (let $t0 = not b1 in
      if $t0 then not b2
            else 1'h0) in
      if not $t1 then (let $t3 = (let $t2 = not b1 in
            if $t2 then b2
                  else 1'h0) in
            if not $t3 then trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 f32)) 128'h1) 128'h20))
                  else trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (1'h0 # j # 1'h0 # l # m))) 128'h1) 128'h20)))
            else trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (1'h0 # j # 1'h1 # l # m))) 128'h1) 128'h20))

Main.swapix4 : ([1024], [5]) -> [32]
Main.swapix4 s f32 =
      let $ds = Main.explode5 f32 in
      let b1 = (let b1 = $ds[4 +: 1] in
      b1) in
      let j = (let j = $ds[3 +: 1] in
      j) in
      let k = (let k = $ds[2 +: 1] in
      k) in
      let l = (let l = $ds[1 +: 1] in
      l) in
      let b2 = (let b2 = $ds[0 +: 1] in
      b2) in
      let $t0 = (if b1 then not b2
            else 1'h0) in
      if not $t0 then (let $t1 = (if b1 then b2
                  else 1'h0) in
            if not $t1 then trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 f32)) 128'h1) 128'h20))
                  else trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (1'h1 # j # k # l # 1'h0))) 128'h1) 128'h20)))
            else trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (1'h1 # j # k # l # 1'h1))) 128'h1) 128'h20))

Main.xorix : ([1024], [5]) -> [32]
Main.xorix s f32 =
      let $ds = Main.explode5 f32 in
      let j = (let j = $ds[3 +: 1] in
      j) in
      let k = (let k = $ds[2 +: 1] in
      k) in
      let l = (let l = $ds[1 +: 1] in
      l) in
      let m = (let m = $ds[0 +: 1] in
      m) in
      let i1 = 1'h1 # j # k # l # m in
      let $t1 = (let $t0 = (let h = $ds[4 +: 1] in
      h) in
      not $t0) in
      if not $t1 then trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 i1)) 128'h1) 128'h20))
            else xor (trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 (1'h0 # j # k # l # m))) 128'h1) 128'h20))) (trunc 32 (lshr s (mul (sub (sub 128'h20 (zext 128 i1)) 128'h1) 128'h20)))

Main.xor : ([1024]) -> [1024]
Main.xor s =
      Main.xorix s 5'h0 # Main.xorix s 5'h1 # Main.xorix s 5'h2 # Main.xorix s 5'h3 # Main.xorix s 5'h4 # Main.xorix s 5'h5 # Main.xorix s 5'h6 # Main.xorix s 5'h7 # Main.xorix s 5'h8 # Main.xorix s 5'h9 # Main.xorix s 5'ha # Main.xorix s 5'hb # Main.xorix s 5'hc # Main.xorix s 5'hd # Main.xorix s 5'he # Main.xorix s 5'hf # Main.xorix s 5'h10 # Main.xorix s 5'h11 # Main.xorix s 5'h12 # Main.xorix s 5'h13 # Main.xorix s 5'h14 # Main.xorix s 5'h15 # Main.xorix s 5'h16 # Main.xorix s 5'h17 # Main.xorix s 5'h18 # Main.xorix s 5'h19 # Main.xorix s 5'h1a # Main.xorix s 5'h1b # Main.xorix s 5'h1c # Main.xorix s 5'h1d # Main.xorix s 5'h1e # Main.xorix s 5'h1f

