device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __resumption_tag : [2] init 2'h2
      register __st0 : [1] init 1'h0
      tag _unused3 = 0
      tag _unused = 1
      let $res = if not __resumption_tag[1 +: 1] then (let b$i1 = __resumption_tag[0 +: 1] in
                  b$i1 # 1'h0 # b$i1 # b$i1)
                  else 4'h0
      __out0 := $res[3 +: 1]
      next __resumption_tag := $res[1 +: 2]
      next __st0 := $res[0 +: 1]