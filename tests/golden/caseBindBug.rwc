--| block '$L.arm' of process main
--| also: main._unused3
main.arm : ([1]) -> [2]
main.arm s0 =
      s0 # s0

device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __st0 : [1] init 1'h0
      tag $x2 = 0
      let $res = if not __in0 then main.arm __st0
                  else let $a$i0 = not __st0 in
                  main.arm $a$i0
      __out0 := $res[1 +: 1]
      next __st0 := $res[0 +: 1]