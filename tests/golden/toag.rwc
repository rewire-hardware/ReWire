device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __resumption_tag : [3] init 3'h4
      tag z = 0
      tag y = 1
      tag x = 2
      let $res = if eq __resumption_tag[1 +: 2] 2'h0 then 4'h4
                  else if eq __resumption_tag[1 +: 2] 2'h1 then (let x$i0 = __resumption_tag[0 +: 1] in
                  let $a$i2 = (if not __in0 then (let $a$i1 = (if x$i0 then x$i0
                              else 1'h0) in
                        $a$i1)
                        else x$i0) in
                  let $a1$i3 = (if $a$i2 then __in0
                        else 1'h0) in
                  $a1$i3 # 3'h0) else if not __in0 then __in0 # 2'h1 # __in0 else 3'h1 # __in0
      __out0 := $res[3 +: 1]
      next __resumption_tag := $res[0 +: 3]