extern andW32
      input p0 : [32]
      input p1 : [32]
      output p2 : [32]
      model Main.andModel

extern notW32
      input p0 : [32]
      output p1 : [32]
      model Main.notModel

extern plusW32
      input p0 : [32]
      input p1 : [32]
      output p2 : [32]
      model Main.plusModel

extern xorW32
      input p0 : [32]
      input p1 : [32]
      output p2 : [32]
      model Main.xorModel

Main.andModel : ([32], [32]) -> [32]
Main.andModel a b =
      and a b

Main.xorModel : ([32], [32]) -> [32]
Main.xorModel a b =
      xor a b

Main.notModel : ([32]) -> [32]
Main.notModel $eta0 =
      not $eta0

Main.plusModel : ([32], [32]) -> [32]
Main.plusModel a b =
      add a b

device top_level
      input __in0 : [32]
      output __out0 : [32]
      tag $x2 = 0
      let $res = let $a$i3 = (let $eta0$i0 = andW32 __in0 32'hf0f0f0f0 in
            let $eta1$i2 = (let $eta0$i1 = notW32 __in0 in
            xorW32 $eta0$i1 32'h12345678) in
            plusW32 $eta0$i0 $eta1$i2) in
            $a$i3
      __out0 := $res