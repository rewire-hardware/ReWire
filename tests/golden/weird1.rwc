device top_level
      input __in0 : [1]
      output __out0 : [1]
      register __st0 : [1] init 1'h0
      register __st1 : [1] init 1'h0
      tag $x2 = 0
      let $res = let disc$i0 = __st0 # __st1 in
            1'h0 # disc$i0
      __out0 := $res[2 +: 1]
      next __st0 := $res[1 +: 1]
      next __st1 := $res[0 +: 1]