device top_level
      output __out0 : [8]
      register __resumption_tag : [8] init 8'h0
      register __st0 : [8] init 8'h0
      tag $ds = 0
      let $res = let s01$i2 = add __resumption_tag 8'h1 in
            s01$i2 # s01$i2 # s01$i2
      __out0 := $res[16 +: 8]
      next __resumption_tag := $res[8 +: 8]
      next __st0 := $res[0 +: 8]