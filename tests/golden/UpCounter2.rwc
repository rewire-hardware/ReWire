--| block '$L.Main.go' of process main
main.go : ([8]) -> [16]
main.go s0 =
      s0 # s0

device top_level
      input __in0 : [1]
      output __out0 : [8]
      register __st0 : [8] init 8'h0
      tag b = 0
      let $res = if not __in0 then (let $a$i0 = add __st0 8'h1 in
                  main.go $a$i0)
                  else let $a$i1 = or (shl __st0 8'h1) (zext 8 __st0[7 +: 1]) in
                  main.go $a$i1
      __out0 := $res[8 +: 8]
      next __st0 := $res[0 +: 8]