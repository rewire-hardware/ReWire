--| block '$L.Main.tick' of process main
main.tick : ([8]) -> [16]
main.tick s0 =
      s0 # s0

device top_level
      input __in0 : [1]
      output __out0 : [8]
      register __st0 : [8] init 8'h0
      tag b = 0
      let $res = if not __in0 then main.tick __st0
                  else main.tick __st0
      __out0 := $res[8 +: 8]
      next __st0 := $res[0 +: 8]