--| block '$L.Main.incr' of process main
main.incr : ([8]) -> [17]
main.incr s0 =
      9'h4 # s0

--| block '$L.Main.loop' of process main
main.loop : ([8]) -> [17]
main.loop s0 =
      let $a$i1 = (let $t0$i0 = trunc 1 s0 in
      $t0$i0) in
      let $a1$i2 = not $a$i1 in
      if not $a1$i2 then main.incr s0
            else main.incr s0

device top_level
      input __in0 : [8]
      output __out0 : [8]
      register __resumption_tag : [1] init 1'h1
      register __st0 : [8] init 8'h0
      tag $ds = 0
      tag i2 = 1
      let $res = if not __resumption_tag then main.loop __st0
                  else main.loop __in0
      __out0 := $res[9 +: 8]
      next __resumption_tag := $res[8 +: 1]
      next __st0 := $res[0 +: 8]