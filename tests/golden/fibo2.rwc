--| block '$L.Main.loop' of process main
main.loop : ([8], [8]) -> [25]
main.loop n m =
      n # 1'h0 # n # m

device top_level
      input __in0 : [1]
      output __out0 : [8]
      register __resumption_tag : [17] init 17'h10001
      tag b2 = 0
      tag b = 1
      let $res = if not __resumption_tag[16 +: 1] then (let n$i0 = __resumption_tag[8 +: 8] in
                  let m$i1 = __resumption_tag[0 +: 8] in
                  if not __in0 then main.loop m$i1 (add n$i0 m$i1)
                        else main.loop n$i0 m$i1)
                  else let m$i2 = __resumption_tag[0 +: 8] in
                  if not __in0 then main.loop m$i2 (add 8'h0 m$i2)
                        else main.loop 8'h0 m$i2
      __out0 := $res[17 +: 8]
      next __resumption_tag := $res[0 +: 17]