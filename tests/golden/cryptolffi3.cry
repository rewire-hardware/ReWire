// Generated by rwc from device: top_level.
// rw_device maps a sequence of per-cycle inputs to per-cycle outputs.

module top_level where

// Helpers implementing ReWire Hyle primitive semantics.
rw'resize : {m, n} (fin m, fin n) => [n] -> [m]
rw'resize x = drop`{n} ((zero : [m]) # x)

rw'repl : {n, w} (fin n, fin w) => [w] -> [n * w]
rw'repl x = join (repeat`{n} x)

rw'parity : {n} (fin n) => [n] -> Bit
rw'parity x = foldr (^) False x

rw'sext : {m, n} (fin m, fin n, n >= 1) => [n] -> [m]
rw'sext x = if x @ 0 then ~ (rw'resize (~ x)) else rw'resize x

// Per-cycle step: outputs # next register values.
rw_step : [18] -> [8]
rw_step i = s12
  where
    s0 : [2]
    s0 = take`{2} i
    s1 : [8]
    s1 = take`{8} (drop`{2} i)
    s2 : [8]
    s2 = drop`{10} i
    s3 : [8]
    s3 = s1 + s2
    s4 : [16]
    s4 = s3 # s1
    s5 : [8]
    s5 = ((drop`{4} s1) + (if (take`{4} s1) == 0xf then 0x1 else 0x0)) # ((take`{4} s1) + 0x1)
    s6 : [8]
    s6 = ((take`{8} s4) ^ (drop`{8} s4)) ^ ((drop`{4} s5) # (take`{4} s5))
    s7 : [8]
    s7 = (drop`{7} s1) # ((take`{1} (drop`{6} s1)) # ((take`{1} (drop`{5} s1)) # ((take`{1} (drop`{4} s1)) # ((take`{1} (drop`{3} s1)) # ((take`{1} (drop`{2} s1)) # ((take`{1} (drop`{1} s1)) # (take`{1} s1)))))))
    s8 : [8]
    s8 = s2 - s7
    s9 : [8]
    s9 = s6 ^ s8
    s10 : [10]
    s10 = if s0 == 0b00 then 0b0000000000 else (if s0 == 0b01 then 0b0100000000 else (0b10 # s9))
    s11 : [8]
    s11 = if (take`{2} s10) == 0b00 then (s6 + s8) else (if (take`{2} s10) == 0b01 then (s6 - s8) else (if (take`{2} s10) == 0b10 then (drop`{2} s10) else 0x00))
    s12 : [8]
    s12 = s11

// Device: top_level
// Inputs, MSB-first: __in0 : [2], __in1 : [8], __in2 : [8]
// Outputs, MSB-first: __out0 : [8]
rw_device : {n} (fin n) => [n][18] -> [n][8]
rw_device ins = [rw_step i | i <- ins]