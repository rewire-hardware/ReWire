    s14 = drop`{3} s0
    s15 : [1]
    s15 = [s1 == 0x00]
    s16 : [8]
    s16 = s14 + s1
    s17 : [8]
    s17 = drop`{3} s0
    s18 : [1]
    s18 = [s1 == 0x00]
    s19 : [8]
    s19 = s17 - s1
    s20 : [8]
    s20 = drop`{3} s0
    s21 : [1]
    s21 = [s1 == 0x00]
    s22 : [8]
    s22 = s20 + s1
    s23 : [8]
    s23 = drop`{3} s0
    s24 : [1]
    s24 = [s1 == 0x00]
    s25 : [8]
    s25 = s23 - s1
    s26 : [19]
    s26 = if (take`{3} s0) == 0b000 then (if ~ (s3 @ 0) then (s4 # (0b000 # s4)) else 0b0000000001000000000) else (if (take`{3} s0) == 0b001 then (if ~ (s6 @ 0) then (s7 # (0b001 # s7)) else 0b0000000001000000000) else (if (take`{3} s0) == 0b010 then (if ~ (s9 @ 0) then (s10 # (0b010 # s10)) else 0b1111111100111111111) else (if (take`{3} s0) == 0b011 then (if ~ (s12 @ 0) then (s13 # (0b011 # s13)) else 0b1111111100111111111) else (if (take`{3} s0) == 0b100 then (if ~ (s15 @ 0) then (s16 # (0b100 # s16)) else 0b0000000001000000000) else (if (take`{3} s0) == 0b101 then (if ~ (s18 @ 0) then (s19 # (0b101 # s19)) else 0b0000000001000000000) else (if (take`{3} s0) == 0b110 then (if ~ (s21 @ 0) then (s22 # (0b110 # s22)) else 0b1111111110111111111) else (if ~ (s24 @ 0) then (s25 # (0b111 # s25)) else 0b1111111110111111111)))))))

// Device: top_level
// Inputs, MSB-first: __in0 : [8]
// Outputs, MSB-first: __out0 : [8]
rw_device : {n} (fin n) => [n][8] -> [n][8]
rw_device ins = outs
  where
